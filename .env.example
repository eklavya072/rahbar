# All free, no credit card. Copy to .env.local and fill in.
# Groq (primary LLM + Prompt Guard): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: comma-separated Groq models, tried in order
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional backup (only ever receives anonymised text): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
